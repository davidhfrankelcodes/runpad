# runpad deployment configuration. Copy to .env and fill in both values.
# Everything else is configured in the UI and stored in Postgres.

# Password for the bundled Postgres database.
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Key used to encrypt stored secrets (SSH keys, tokens). At least 32 characters.
# Generate with: openssl rand -hex 32
# Keep it safe: changing or losing it makes existing stored secrets unreadable.
RUNPAD_SECRET_KEY=

# Optional: where browsers load theme.park themes from (each user picks one on their
# Account page). Defaults to the public site; set it to a self-hosted theme.park instead.
# RUNPAD_THEMEPARK_URL=https://theme-park.dev

# Running the backend outside Docker (uv run uvicorn ...) also needs DATABASE_URL.
# With compose.dev.yaml, Postgres is exposed on localhost:
# DATABASE_URL=postgresql+psycopg://runpad:<POSTGRES_PASSWORD>@localhost:5432/runpad
